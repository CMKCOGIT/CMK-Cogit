      direction: ASC
    order:
      - file.name
      - note.tipo_preco
      - note.preco
      - note.unidade
      - note.formato
      - note.horas
      - formula.valor_hora
      - note.status
  - type: table
    name: Loja virtual
    filters:
      or:
        - 'servicos.contains("loja-virtual")'
        - 'incluso_em.contains("loja-virtual")'
    groupBy:
