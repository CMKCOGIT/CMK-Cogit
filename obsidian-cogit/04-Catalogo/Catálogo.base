# Catálogo de serviços e funcionalidades da COGIT (Obsidian Bases).
# Cada linha é uma nota de 04-Catalogo/Itens. Edite preço, status e horas direto na tabela.
# Depois rode: python3 _sistema/catalogo.py  (atualiza as tabelas das notas e o catalogo.json)
filters:
  and:
    - file.inFolder("04-Catalogo/Itens")
    - 'tipo == "item"'
formulas:
  valor_hora: 'if(horas, (preco / horas).round(), "")'
properties:
  file.name:
    displayName: Item
  note.categoria:
    displayName: Categoria
  note.tipo_preco:
    displayName: Tipo de preço
  note.preco:
    displayName: Preço (R$)
  note.unidade:
    displayName: Unidade
  note.formato:
    displayName: Formato
  note.horas:
    displayName: Horas estimadas
  formula.valor_hora:
    displayName: R$ por hora
  note.status:
    displayName: Status
  note.servicos:
    displayName: Serviços
views:
  - type: table
    name: Todos os itens
    groupBy:
      property: note.categoria
      direction: ASC
    order:
      - file.name
      - note.tipo_preco
      - note.preco
      - note.unidade
      - note.formato
      - note.horas
      - formula.valor_hora
      - note.status
      - note.servicos
  - type: table
    name: A validar
    filters:
      and:
        - 'status == "a-validar"'
    groupBy:
      property: note.categoria
      direction: ASC
    order:
      - file.name
      - note.tipo_preco
      - note.preco
      - note.unidade
      - note.formato
      - note.horas
      - formula.valor_hora
      - note.status
  - type: table
    name: Landing Page
    filters:
      or:
        - 'servicos.contains("landing-page")'
        - 'incluso_em.contains("landing-page")'
    groupBy:
      property: note.categoria
      direction: ASC
    order:
      - file.name
      - note.tipo_preco
      - note.preco
      - note.unidade
      - note.formato
      - note.horas
      - formula.valor_hora
      - note.status
  - type: table
    name: Portfólio digital
    filters:
      or:
        - 'servicos.contains("portfolio")'
        - 'incluso_em.contains("portfolio")'
    groupBy:
      property: note.categoria
      direction: ASC
    order:
      - file.name
      - note.tipo_preco
      - note.preco
      - note.unidade
      - note.formato
      - note.horas
      - formula.valor_hora
      - note.status
  - type: table
    name: Site institucional
    filters:
      or:
        - 'servicos.contains("site-institucional")'
        - 'incluso_em.contains("site-institucional")'
    groupBy:
